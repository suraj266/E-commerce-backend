model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  /// Optional. Sellers require it (enforced at DTO layer); customers and
  /// admins may sign up without one. Postgres treats NULLs as distinct in
  /// the unique index, so multiple users without a phone are allowed.
  phone           String?   @unique
  password        String
  gender          String?
  dateOfBirth     DateTime?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  phoneVerifiedAt DateTime?
  status          String?   @default("active")

  // Nayi fields for scaling
  metadata  Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  roleId    String?

  role                     Role?                    @relation(fields: [roleId], references: [id])
  createdRoles             Role[]                   @relation("roleCreatedBy")
  updatedRoles             Role[]                   @relation("roleUpdatedBy")
  assignedRoles            RolePermission[]         @relation("rolePermissionAssignedBy")
  revokedRoles             RolePermission[]         @relation("rolePermissionRevokedBy")
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]

  // Identity & Auth extensions
  addresses UserAddress[]
  apiKeys   ApiKey[]
  sessions  Session[]
  Seller    Seller?
  Customer  Customer?

  passwordResetTokens PasswordResetToken[]
}

/// Single-use token for the forgot-password flow.
/// Mirrors the EmailVerificationToken pattern (token, expiresAt, usedAt).
/// In dev the token is returned in the API response so the frontend can
/// surface a click-through link until SMTP is wired. Production sends
/// only via email.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAddress {
  id           String  @id @default(uuid())
  userId       String
  type         String // 'billing', 'shipping', 'both'
  label        String?
  firstName    String
  lastName     String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  countryCode  String
  isDefault    Boolean @default(false)

  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsShippingAddress Order[] @relation("OrderShippingAddress")
  ordersAsBillingAddress  Order[] @relation("OrderBillingAddress")
}

model ApiKey {
  id          String @id @default(uuid())
  userId      String
  name        String
  keyHash     String @unique
  keyPrefix   String
  permissions Json   @default("[]")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
