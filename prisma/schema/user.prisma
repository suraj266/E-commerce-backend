model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String    @unique
  password        String
  gender          String?
  dateOfBirth     DateTime?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  phoneVerifiedAt DateTime?
  status          String?   @default("active")

  // Nayi fields for scaling
  metadata  Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  roleId    String?

  role          Role?            @relation(fields: [roleId], references: [id])
  createdRoles  Role[]           @relation("roleCreatedBy")
  updatedRoles  Role[]           @relation("roleUpdatedBy")
  assignedRoles RolePermission[] @relation("rolePermissionAssignedBy")
  revokedRoles  RolePermission[] @relation("rolePermissionRevokedBy")
  refreshTokens RefreshToken[]

  // Identity & Auth extensions
  addresses UserAddress[]
  apiKeys   ApiKey[]
  sessions  Session[]
  Seller    Seller?
}

model UserAddress {
  id           String  @id @default(uuid())
  userId       String
  type         String // 'billing', 'shipping', 'both'
  label        String?
  firstName    String
  lastName     String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  countryCode  String
  isDefault    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String @id @default(uuid())
  userId      String
  name        String
  keyHash     String @unique
  keyPrefix   String
  permissions Json   @default("[]")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
