enum StoreStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
  UNDER_REVIEW
}

model Store {
  id             String      @id @default(uuid())
  sellerId       String
  name           String
  slug           String      @unique
  description    String?
  logoUrl        String?
  bannerUrl      String?
  customDomain   String?     @unique
  subdomain      String?     @unique
  currencyCode   String      @default("INR")
  timezone       String      @default("Asia/Kolkata")
  locale         String      @default("en-IN")

  // Optional state override. When a seller operates stores registered in
  // different states (separate GSTIN per state), each store carries its own.
  // Falls back to Seller.stateCode in place-of-supply determination if null.
  stateCode      String?     @db.Char(2)
  stateName      String?
  supportEmail   String?
  supportPhone   String?
  themeConfig    Json        @default("{}")
  taxConfig      Json        @default("{}")
  shippingConfig Json        @default("{}")
  status         StoreStatus @default(DRAFT)
  isFeatured     Boolean     @default(false)
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  seller       Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  settings     StoreSetting[]
  warehouses   Warehouse[]
  products     Product[]
  coupons      Coupon[]
  sellerOrders SellerOrder[]
  orderItems   OrderItem[]
}

model StoreSetting {
  id      String  @id @default(uuid())
  storeId String
  key     String
  value   String?
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

model Warehouse {
  id           String    @id @default(uuid())
  storeId      String
  name         String
  code         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  countryCode  String    @default("IN")
  phone        String?
  /// Cached pickup-location id from the courier provider (e.g. Shiprocket
  /// `addpickup`) so we don't re-register on every shipment.
  providerLocationId String?
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventories Inventory[]
  movements   InventoryMovement[]

  @@unique([storeId, code])
}
