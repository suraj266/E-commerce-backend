/// Cart — active shopping cart for a customer OR an anonymous guest session.
///
/// Ownership is exclusive: EXACTLY ONE of `customerId` / `sessionToken` is set
/// (enforced by a DB CHECK — see migration 20260718110000_guest_cart). A
/// customer cart FKs `Customer.id`; a guest cart is keyed only by an opaque,
/// httpOnly-cookie `sessionToken`. On login the guest cart is merged into the
/// customer's cart (sum/dedupe by variant, soft-fail — never blocks login) and
/// the guest cart + cookie are discarded.
///
/// NOTE: `customerId` / `sessionToken` carry `@unique` here so Prisma keeps the
/// 1-1 `Customer.cart` relation and `findUnique` lookups. The PHYSICAL indexes
/// are PARTIAL (`WHERE ... IS NOT NULL`) so many guest carts (customerId NULL)
/// and many customer carts (sessionToken NULL) coexist — see the hand-written
/// migration. Prisma cannot express partial uniques; this mirrors the Phase-1
/// pattern of DB constraints living in raw SQL.
///
/// `CartItem.unitPriceSnapshot` captures the variant price at the time of
/// add. The /cart page compares it against the live `ProductVariant.price`
/// and surfaces a `priceChanged` indicator if drift occurred — the
/// customer can then accept the new price or remove the item. We do NOT
/// auto-update the snapshot, since silently changing a customer's cart
/// total is hostile UX.
///
/// `quantity` is enforced > 0 at the application layer (DTO + service).
/// To "remove" an item, the API deletes the row rather than setting qty
/// to 0 — keeps the unique (cartId, variantId) constraint clean.

model Cart {
  id String @id @default(uuid())

  /// Owner side A — the Customer this cart belongs to. Null for guest carts.
  customerId String? @unique
  /// Owner side B — opaque guest-session token (httpOnly cookie). Null for
  /// customer carts. Exactly one of customerId / sessionToken is non-null.
  sessionToken String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  /// Required — cart items always reference a concrete buyable variant.
  /// SIMPLE products' default variant is auto-created at product-create
  /// time, so there's always exactly one variant to point at.
  variantId String
  quantity  Int

  /// Variant.price at the moment this item was added. Used for price-drift
  /// detection on cart read; never updated after creation.
  unitPriceSnapshot Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([productId])
}
