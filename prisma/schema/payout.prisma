/// =============================================================================
/// Payout — seller settlement ledger (Phase 2, P2-02).
/// =============================================================================
///
/// A Payout is one settlement run for a single seller: it aggregates the
/// seller's eligible (DELIVERED + PAID + payoutStatus=PENDING + non-refunded)
/// SellerOrders into a set of PayoutItems, nets out any PROCESSED refunds, and
/// records the manual bank/UPI transfer (UTR) once finance disburses it.
///
/// Lifecycle:
///   PROCESSING → PAID     (finance pastes the UTR into markPayoutPaid)
///   PROCESSING → FAILED   (transfer failed; items deleted, orders reverted)
///
/// Hard settle-once guarantee: `PayoutItem.sellerOrderId @unique`. Two racing
/// payout runs collide on this unique (P2002) — the loser skips that order,
/// so a seller order is never settled twice.
///
/// Raw-SQL CHECKs (Payout.netAmount >= 0, PayoutItem.amount >= 0) live in the
/// hand-authored migration — Prisma cannot model CHECK constraints.
///
/// Reuses the existing `PayoutStatus` enum (order.prisma).

model Payout {
  id       String       @id @default(uuid())
  sellerId String
  status   PayoutStatus @default(PROCESSING)

  /// Sum of eligible seller-order payout amounts before refund netting.
  grossAmount Decimal @db.Decimal(10, 2) @default(0)
  /// Total PROCESSED-refund amount subtracted from the gross.
  refundAdjustment Decimal @db.Decimal(10, 2) @default(0)
  /// TCS §52 withheld from the seller at settlement (P3-03): the net
  /// accrued-minus-reversed TCS for this run's seller orders. The operator
  /// deducts it here and deposits it to the government (GSTR-8), so it never
  /// reaches the seller. // NEEDS CA SIGN-OFF — that TCS is withheld at payout.
  /// Raw-SQL CHECK "payout_tcs_nonneg" (>= 0) lives in the hand-authored migration.
  tcsAdjustment Decimal @db.Decimal(10, 2) @default(0)
  /// Return-driven commission CLAWBACK absorbed by this run (P3-02): the sum of
  /// PENDING PayoutAdjustment magnitudes greedily netted out of this payout.
  /// Carried forward (stays PENDING) when a run can't absorb it — the seller is
  /// never paid a negative. // NEEDS FINANCE SIGN-OFF — clawback basis + carry.
  /// Raw-SQL CHECK "payout_clawback_nonneg" (>= 0) lives in the hand-authored migration.
  clawbackAdjustment Decimal @db.Decimal(10, 2) @default(0)
  /// grossAmount − refundAdjustment − tcsAdjustment − clawbackAdjustment. The amount actually transferred.
  netAmount Decimal @db.Decimal(10, 2) @default(0)
  currencyCode String @default("INR")

  /// Optional settlement period bounds (for reporting / statements).
  periodStart DateTime?
  periodEnd   DateTime?

  /// Bank/UPI transaction reference pasted by finance on disbursement.
  utr         String?
  providerRef String?
  failureReason String?

  /// Masked snapshot of the seller payout account used, captured at run time
  /// so the ledger row is self-describing even if the account is later edited.
  accountType         String?
  accountHolderName   String?
  accountNumberMasked String?
  ifscCode            String?
  upiId               String?

  createdById String?
  paidAt      DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items  PayoutItem[]
  /// Return-driven clawbacks (P3-02) absorbed by this run (SetNull-linked so a
  /// carried-forward adjustment survives a run being deleted/failed).
  adjustments PayoutAdjustment[]

  @@index([sellerId])
  @@index([status])
}

/// =============================================================================
/// PayoutAdjustment — carry-forward seller-payout ledger delta (Phase 3, P3-02).
/// =============================================================================
///
/// A return that reaches QC_PASSED refunds the buyer even when the seller order
/// was ALREADY settled — so the platform must recover the commission/settled
/// amount from the seller. Instead of the Phase-2 hard-block ("cannot refund a
/// paid-out order"), a return writes a PENDING clawback here; PayoutService nets
/// it out of the seller's NEXT payout, greedily and in full-adjustment units,
/// carrying any unabsorbed clawback forward. A seller is NEVER paid a negative.
///
/// `amount` is a POSITIVE magnitude to DEDUCT (the sign is applied in code).
/// Idempotency: partial UNIQUE "PayoutAdjustment_return_clawback_unique" on
/// (returnId) WHERE kind='RETURN_CLAWBACK' (hand-authored migration) → a retried
/// QC_PASSED writes at most one clawback per return (createMany skipDuplicates).
///
/// CHECK "payout_adjustment_amount_nonneg" (amount >= 0) lives in the migration.
///
/// // NEEDS FINANCE SIGN-OFF — the clawback basis (seller payout amount vs
/// // commission-only vs proportional-to-returned-lines) and carry-forward rule.

enum PayoutAdjustmentKind {
  /// Commission/settlement clawback for a QC-passed return (v1).
  RETURN_CLAWBACK
}

enum PayoutAdjustmentStatus {
  PENDING /// Not yet absorbed by a payout run (carried forward each run).
  APPLIED /// Fully netted out of `payoutId`.
  VOID    /// Reversed by finance (unused by the automated flow).
}

model PayoutAdjustment {
  id       String @id @default(uuid())
  sellerId String

  /// Origin linkage (scalar FKs — the return/refund models live elsewhere).
  sellerOrderId String?
  returnId      String?
  refundId      String?

  kind   PayoutAdjustmentKind   @default(RETURN_CLAWBACK)
  status PayoutAdjustmentStatus @default(PENDING)

  /// Positive magnitude to deduct from the seller's next payable.
  amount      Decimal @db.Decimal(10, 2)
  description String?

  /// Set when a payout run absorbs it.
  payoutId    String?
  createdById String?
  appliedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payout Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([sellerId, status])
  @@index([returnId])
  @@index([payoutId])
}

model PayoutItem {
  id       String @id @default(uuid())
  payoutId String
  /// @unique is the settle-at-most-once guarantee for a seller order.
  sellerOrderId String @unique

  /// Seller-order payout amount included in this run.
  amount Decimal @db.Decimal(10, 2)
  /// PROCESSED-refund amount attributed to this seller order at run time.
  refundedAmount Decimal @db.Decimal(10, 2) @default(0)
  /// Net accrued-minus-reversed TCS §52 withheld for this seller order (P3-03).
  /// Rolls up into Payout.tcsAdjustment. Raw-SQL CHECK "payout_item_tcs_nonneg"
  /// (>= 0) lives in the hand-authored migration.
  tcsDeducted Decimal @db.Decimal(10, 2) @default(0)

  createdAt DateTime @default(now())

  payout      Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  @@index([payoutId])
}
