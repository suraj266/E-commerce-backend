model Category {
  id           String    @id @default(uuid())
  parentId     String?
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  iconUrl      String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  parent   Category?  @relation("CatHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CatHierarchy")
  products Product[]
}

// Tag model lives in tag.prisma (separate file). Will gain a M:N junction
// with Product when the Product module is rebuilt in Sprint 2.4d.

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

model Product {
  id               String        @id @default(uuid())
  storeId          String
  categoryId       String?
  brandId          String?
  taxId            String?
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  skuPrefix        String?
  productType      ProductType   @default(SIMPLE)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  isDigital        Boolean       @default(false)
  weight           Decimal?      @db.Decimal(10, 2) // kg
  length           Decimal?      @db.Decimal(10, 2) // cm
  width            Decimal?      @db.Decimal(10, 2) // cm
  height           Decimal?      @db.Decimal(10, 2) // cm
  /// Indian GST classification — 4/6/8 digit Harmonized System of Nomenclature
  /// code. Required for tax-invoice issuance. Validated as digits-only at
  /// the DTO layer; stored as string to preserve leading zeros.
  hsnCode          String?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String[]
  /// Per-product PDP specs — array of groups, each with items.
  /// Shape: [{ name: string, order: int, items: [{ label, value, order }] }]
  specifications   Json          @default("[]")
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  tax           Tax?                 @relation(fields: [taxId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  variants      ProductVariant[]
  readDocument  ProductReadDocument?
  tags          Tag[]                @relation("ProductTags")
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([storeId, status])
  @@index([brandId])
  @@index([categoryId])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ProductAttribute, ProductAttributeValue, and ProductVariantAttribute
// have been moved to attribute.prisma (separate file with full schema +
// AttributeType enum + value slug). They're still in the same Prisma
// generator since prismaSchemaFolder feature merges all files.

enum VariantStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

model ProductVariant {
  id             String        @id @default(uuid())
  productId      String
  sku            String        @unique
  name           String?
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  costPrice      Decimal?      @db.Decimal(10, 2)
  barcode        String?
  weight         Decimal?      @db.Decimal(10, 2)
  length         Decimal?      @db.Decimal(10, 2)
  width          Decimal?      @db.Decimal(10, 2)
  height         Decimal?      @db.Decimal(10, 2)
  imageUrl       String?
  status         VariantStatus @default(ACTIVE)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes    ProductVariantAttribute[]
  inventories   Inventory[]
  movements     InventoryMovement[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

// ProductVariantAttribute moved to attribute.prisma alongside the rest of
// the attribute models.

model ProductReadDocument {
  id          String   @id @default(uuid())
  productId   String   @unique
  slug        String   @unique
  isPublished Boolean  @default(false)
  document    Json // Flattened read-model for fast queries
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
