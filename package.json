{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:categories": "ts-node src/prisma/seed/categories.seed.ts",
    "seed:categories:prod": "node dist/prisma/seed/categories.seed.js",
    "seed:taxes": "ts-node src/prisma/seed/taxes.seed.ts",
    "seed:taxes:prod": "node dist/prisma/seed/taxes.seed.js",
    "seed:pages": "ts-node src/prisma/seed/pages.seed.ts",
    "seed:pages:prod": "node dist/prisma/seed/pages.seed.js",
    "seed:menus": "ts-node src/prisma/seed/menus.seed.ts",
    "seed:menus:prod": "node dist/prisma/seed/menus.seed.js",
    "seed:sliders": "ts-node src/prisma/seed/sliders.seed.ts",
    "seed:sliders:prod": "node dist/prisma/seed/sliders.seed.js",
    "seed:emails": "ts-node src/prisma/seed/emailTemplates.seed.ts",
    "seed:emails:prod": "node dist/prisma/seed/emailTemplates.seed.js",
    "seed:emails:header": "ts-node src/prisma/seed/updateEmailHeaderBranding.ts",
    "seed:emails:header:prod": "node dist/prisma/seed/updateEmailHeaderBranding.js",
    "seed:roles": "ts-node src/prisma/seed/rolePermission.seed.ts",
    "seed:roles:prod": "node dist/prisma/seed/rolePermission.seed.js",
    "seed:settings": "ts-node src/prisma/seed/siteSettings.seed.ts",
    "seed:settings:prod": "node dist/prisma/seed/siteSettings.seed.js",
    "seed:demo": "ts-node src/prisma/seed/demoData.seed.ts",
    "seed:demo:prod": "node dist/prisma/seed/demoData.seed.js",
    "seed:invoices": "ts-node src/prisma/seed/invoiceTemplates.seed.ts",
    "seed:invoices:prod": "node dist/prisma/seed/invoiceTemplates.seed.js",
    "seed:labels": "ts-node src/prisma/seed/labels.seed.ts",
    "seed:labels:prod": "node dist/prisma/seed/labels.seed.js",
    "seed:collections": "ts-node src/prisma/seed/collections.seed.ts",
    "seed:collections:prod": "node dist/prisma/seed/collections.seed.js",
    "seed:posters": "ts-node src/prisma/seed/posterProducts.seed.ts",
    "seed:posters:prod": "node dist/prisma/seed/posterProducts.seed.js",
    "seed:all": "pnpm seed:roles && pnpm seed:taxes && pnpm seed:categories && pnpm seed:settings && pnpm seed:pages && pnpm seed:menus && pnpm seed:sliders && pnpm seed:emails && pnpm seed:invoices && pnpm seed:labels && pnpm seed:demo && pnpm seed:collections && pnpm seed:posters",
    "seed:all:prod": "pnpm seed:roles:prod && pnpm seed:taxes:prod && pnpm seed:categories:prod && pnpm seed:settings:prod && pnpm seed:pages:prod && pnpm seed:menus:prod && pnpm seed:sliders:prod && pnpm seed:emails:prod && pnpm seed:invoices:prod && pnpm seed:labels:prod && pnpm seed:demo:prod && pnpm seed:collections:prod && pnpm seed:posters:prod"
  },
  "prisma": {
    "seed": "node dist/prisma/seed/rolePermission.seed.js",
    "seed:dev": "ts-node src/prisma/seed/rolePermission.seed.ts"
  },
