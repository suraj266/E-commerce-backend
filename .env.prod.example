# Production environment for docker-compose.prod.yml.
# Copy to `.env.prod` and fill with REAL, ROTATED secrets (see docs/SECRETS-ROTATION.md).
# .env.prod is gitignored — never commit it.

NODE_ENV=production
PORT=7000

# Database (the compose `db` service uses these; DATABASE_URL is derived in compose)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ecommerce_db

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_ALGORITHM=HS256
REFRESH_TOKEN_SECRET=CHANGE_ME_different_from_jwt
REFRESH_TOKEN_EXPIRES_IN=7d

# 64-hex (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this requires the re-encryption script — see docs/SECRETS-ROTATION.md.
PAYMENT_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

FRONTEND_URL=https://your-storefront-domain
COOKIE_DOMAIN=your-domain

# Mail (transactional email)
MAIL_ID=your-smtp-user
MAIL_APP_PASSWORD=CHANGE_ME

# Media: local | s3
IMAGE_PROVIDER=s3
# AWS_S3_BUCKET=...
# AWS_S3_REGION=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Courier sandbox toggle
COURIER_ALLOW_MOCK=false

# Optional (Phase-2 observability — leave unset to disable Sentry cleanly)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
