# =========================================================================
# Backend env vars. Copy to `.env` and fill in real values.
# Secrets (JWT, REFRESH, PAYMENT_ENCRYPTION_KEY, AWS, MAIL) MUST be rotated
# per environment — never reuse dev secrets in prod.
# =========================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=7000

# ---- Database (Postgres) ----
POSTGRES_USER=suraj
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ecommerce_db
# When running via docker-compose, `db` is the service name. For local-only
# Node (not in docker), replace `db` with `localhost`.
DATABASE_URL=postgresql://suraj:change_me_strong_password@db:5432/ecommerce_db?schema=public

# ---- JWT (access token) ----
# JWT_SECRET: 32+ random bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1H
JWT_ALGORITHM=HS256

# ---- Refresh token ----
# MUST be different from JWT_SECRET. Same generation as above.
REFRESH_TOKEN_SECRET=replace_with_different_long_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Frontend / CORS ----
# Used for CORS origin + verification-email links. No trailing slash.
FRONTEND_URL=http://localhost:3000

# ---- Image storage ----
# `local`  → stores under LOCAL_UPLOAD_DIR (mounted volume in docker)
# `s3`     → uses the AWS_* vars below (LOCAL_* ignored)
IMAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=/app/uploads
# Public base URL the browser uses to fetch local-stored images / review
# media. In prod, set this to your backend's public domain.
LOCAL_PUBLIC_BASE_URL=http://localhost:7000

# ---- S3 (only when IMAGE_PROVIDER=s3) ----
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_BASE_URL=

# ---- Email (fallback Gmail SMTP) ----
# Admin panel can override these via the encrypted DB-stored SMTP config.
# Used only until an admin saves a real SMTP profile in the admin UI.
MAIL_ID=your_gmail@gmail.com
MAIL_APP_PASSWORD=your_16_char_app_password

# ---- Payment credentials encryption ----
# AES-256-GCM key — exactly 32 bytes hex (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ROTATION: this key decrypts every stored PaymentGatewayConfig.credentials.
# Do NOT just swap it — that bricks every saved gateway credential. Instead run
# the one-shot re-encryption script, which decrypts with the old key and
# re-encrypts with the new key in a single transaction:
#   export OLD_PAYMENT_ENCRYPTION_KEY=<current key>
#   export NEW_PAYMENT_ENCRYPTION_KEY=<new key>
#   pnpm reencrypt:gateway-creds -- --dry-run   # verify, writes nothing
#   pnpm reencrypt:gateway-creds                # commit the re-encryption
# ONLY THEN set PAYMENT_ENCRYPTION_KEY to the new value below and restart.
# Full runbook: backend/docs/SECRETS-ROTATION.md
PAYMENT_ENCRYPTION_KEY=replace_with_64_hex_chars
